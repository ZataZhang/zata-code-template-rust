# 复制为 .env.local，只在这里保存 Nacos 引导设置。
# namespace、group 与 Data ID 位于 config.toml 的 [nacos]。
NACOS_SERVER_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=

# 高级用法：可用短时令牌代替用户名/密码：
# NACOS_ACCESS_TOKEN=

# 可选：仅供已将 `ObjectStorageConfig` 接入 Settings 的服务使用。
# 本机 zata-ops MinIO 默认地址为 http://127.0.0.1:9000；凭据请在 `.env.local` 配置。
# APP_OBJECT_STORAGE__BACKEND=minio
# APP_OBJECT_STORAGE__ENDPOINT=http://127.0.0.1:9000
# APP_OBJECT_STORAGE__REGION=us-east-1
# APP_OBJECT_STORAGE__BUCKET=rust-study-dev
# APP_OBJECT_STORAGE__PREFIX=
# APP_OBJECT_STORAGE__ACCESS_KEY_ID=
# APP_OBJECT_STORAGE__ACCESS_KEY_SECRET=

# -----------------------------------------------------------------------------
# Agent 服务（services/agent）。正常部署从 Nacos 注入这些秘密，本文件只列出入口，
# 值始终留空；本机直接运行 agent-service 时才在 .env.local 里临时填写。
# -----------------------------------------------------------------------------
# Agent 专属 PostgreSQL；不要与 accounts / agent-tracing 共用数据库。
# 服务读取 DATABASE_URL（也可用 APP_AGENT__DATABASE__URL）。
DATABASE_URL=

# 调用服务凭据清单（JSON 数组，token 至少 32 字符）；浏览器永远不持有这些 token。
AGENT_SERVICE_TOKENS_JSON=

# Agent 向 agent-tracing 投递事件的 producer token；必须与 tracing 服务的 producer 清单一致。
AGENT_TRACING_PRODUCER_TOKEN=

# 外部 A2A Runtime 的 credential_alias → 密钥映射；缺省时对应 Runtime 明确不可用。
AGENT_CREDENTIAL_EXAMPLE_ALIAS=
