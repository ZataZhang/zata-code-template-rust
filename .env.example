# 复制为 .env.local，只在这里保存 Nacos 引导设置。
# namespace、group 与 Data ID 位于 config.toml 的 [nacos]。
NACOS_SERVER_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=

# 高级用法：可用短时令牌代替用户名/密码：
# NACOS_ACCESS_TOKEN=

# 可选：仅供已将 `ObjectStorageConfig` 接入 Settings 的服务使用。
# 本机 zata-ops MinIO 默认地址为 http://127.0.0.1:9000；凭据请在 `.env.local` 配置。
# APP_OBJECT_STORAGE__BACKEND=minio
# APP_OBJECT_STORAGE__ENDPOINT=http://127.0.0.1:9000
# APP_OBJECT_STORAGE__REGION=us-east-1
# APP_OBJECT_STORAGE__BUCKET=rust-study-dev
# APP_OBJECT_STORAGE__PREFIX=
# APP_OBJECT_STORAGE__ACCESS_KEY_ID=
# APP_OBJECT_STORAGE__ACCESS_KEY_SECRET=
