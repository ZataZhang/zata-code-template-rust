# MCP 服务秘密变量清单。值始终留空，由部署平台或仓库根 .env.local 注入。
# 标准启动方式是仓库根执行命令；本服务读取当前工作目录的 .env.local。

# MCP 专属 PostgreSQL；不要与 accounts / agent / agent-tracing 共用数据库。
MCP_DATABASE_URL=

# 凭据加密主密钥：32 字节随机值做标准 Base64，例如：
#   openssl rand -base64 32
MCP_CREDENTIAL_KEY_BASE64=

# 消费服务清单（JSON 数组）。每个 token 至少 32 字符，签名密钥至少 32 字符；
# 浏览器永远不持有这些凭据，只有消费项目后端在服务端调用。
# 示例：
#   MCP_CONSUMERS_JSON=[{"consumer_id":"web-backend","token":"…","context_signing_secret":"…"}]
MCP_CONSUMERS_JSON=

# 以下为可选覆盖项，默认值见 services/mcp/config.toml：
# APP_MCP__SERVER__HOST=127.0.0.1
# APP_MCP__SERVER__PORT=8092
# APP_MCP__LOGGING__FORMAT=text
# APP_MCP__SECURITY__ALLOW_INSECURE_LOOPBACK=false
# APP_MCP__GATEWAY__MAX_REQUEST_BODY_BYTES=1048576
