                  ],
                  "properties": {
                    "tool_call_id": {},
                    "error": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "event_type": {
                  "const": "delegation.started"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "delegation_id",
                    "child_run_id",
                    "child_agent_id",
                    "child_agent_snapshot_checksum",
                    "child_context_pack_checksum",
                    "budget_limit",
                    "failure_policy",
                    "origin"
                  ],
                  "properties": {
                    "delegation_id": {},
                    "child_run_id": {},
                    "child_agent_id": {},
                    "child_agent_snapshot_checksum": {},
                    "child_context_pack_checksum": {},
                    "budget_limit": {},
                    "failure_policy": {},
                    "origin": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "event_type": {
                  "const": "delegation.completed"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "delegation_id",
                    "child_run_id",
                    "status",
                    "result_checksum",
                    "failure_policy"
                  ],
                  "properties": {
                    "delegation_id": {},
                    "child_run_id": {},
