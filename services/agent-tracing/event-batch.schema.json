                }
              }
            },
            {
              "properties": {
                "event_type": {
                  "const": "routing.selected"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "entry_source",
                    "entry_agent_id",
                    "candidate_agent_ids",
                    "selected_agent_id",
                    "reason_code",
                    "policy_checksum",
                    "capability_checksum"
                  ],
                  "properties": {
                    "entry_source": {},
                    "entry_agent_id": {},
                    "candidate_agent_ids": {},
                    "selected_agent_id": {},
                    "reason_code": {},
                    "policy_checksum": {},
                    "capability_checksum": {}
