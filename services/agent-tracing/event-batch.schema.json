                }
              }
            },
            {
              "properties": {
                "event_type": {
                  "const": "delegation.lineage_admitted"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "delegation_id",
                    "child_run_id",
                    "child_agent_id",
