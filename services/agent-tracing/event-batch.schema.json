                    "completed_child_run_ids": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "event_type": {
                  "const": "delegation.rejected"
                },
                "payload": {
                  "type": "object",
                  "required": [
                    "reason_code",
                    "tool_call_id_hash"
                  ],
                  "properties": {
                    "reason_code": {},
                    "tool_call_id_hash": {}
                  },
                  "additionalProperties": false
                }
              }
            },
            {
              "properties": {
                "event_type": {
                  "const": "delegation.unavailable"
