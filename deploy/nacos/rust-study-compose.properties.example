# Nacos Data ID: rust-study-compose.properties
# namespace、group 和应用/Compose Data ID 都由 config.toml 的 [nacos] 段定位。
# 通过 Nacos 控制台或受控发布工具创建远端配置。不要把这里复制为本地部署环境文件。

# 数据库与 Redis 密码（必填，迁移时保留现有值）。
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# tracing 独立 PostgreSQL 密码（必填；URL-safe 随机字符；不要与 accounts 数据库复用）。
AGENT_TRACING_DB_PASSWORD=

# 可登记多个 producer；token 使用至少 32 字符的随机值。没有接入 producer 时留空数组。
AGENT_TRACING_PRODUCERS_JSON=[]

# 引导管理员（不填则没有任何管理员能登录后台）。已存在则不改动，所以事后改这里不会改密码。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# 浏览器经 HTTPS 访问时必须设为 true（本机 http://localhost 用 false）。
COOKIE_SECURE=false

# 上一层 HTTPS 终止代理（Traefik / Caddy / 云负载均衡）的地址段，如 172.16.0.0/12；
# 默认只认直接连进来的对端地址。填错（比如填了 0.0.0.0/0）会让客户端能伪造来源 IP 绕过限流。
TRUSTED_PROXY_CIDR=127.0.0.1

# 宿主机上暴露的端口；COMPOSE_WEB_PORT/COMPOSE_ADMIN_PORT/COMPOSE_ACCOUNTS_PORT 可仅在隔离测试时覆盖。
WEB_PORT=3000
ADMIN_PORT=8081
TRACING_UI_PORT=8082

# 日志格式：json（日志采集）或 text（本机阅读）。
LOG_FORMAT=json
